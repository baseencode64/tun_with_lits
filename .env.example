# GoXRay Docker Environment Variables
# Copy this file to .env and customize as needed

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: text, json
LOG_FORMAT=text

# ============================================
# Metrics Configuration
# ============================================

# Prometheus metrics port (0 = disabled)
# Access metrics at http://localhost:9090/metrics
METRICS_PORT=9090

# ============================================
# VPN Features
# ============================================

# Enable IPv6 support (true/false)
ENABLE_IPV6=false

# Enable DNS leak protection (true/false)
# Routes all DNS queries through VPN tunnel
ENABLE_DNS_PROTECTION=true

# Enable kill switch (true/false)
# Blocks all traffic if VPN disconnects
ENABLE_KILL_SWITCH=true

# ============================================
# Split Tunneling Configuration
# ============================================

# Enable split tunneling (true/false)
SPLIT_TUNNEL_ENABLED=false

# Split tunneling mode: exclude, include, disabled
# - exclude: All traffic through VPN EXCEPT excluded CIDRs
# - include: Only included CIDRs through VPN, rest goes direct
# - disabled: All traffic through VPN (same as SPLIT_TUNNEL_ENABLED=false)
SPLIT_TUNNEL_MODE=exclude

# ============================================
# SOCKS5 Proxy Configuration
# ============================================

# Enable SOCKS5 proxy server (true/false)
# Allows applications to route traffic through VPN via SOCKS5 proxy
SOCKS5_ENABLED=false

# SOCKS5 listen address (default: 0.0.0.0:1080)
# Use "0.0.0.0:1080" to listen on all interfaces
# Use "127.0.0.1:1080" to listen only on localhost
SOCKS5_LISTEN_ADDR=0.0.0.0:1080

# SOCKS5 authentication username (optional, leave empty for no auth)
SOCKS5_USERNAME=

# SOCKS5 authentication password (optional, leave empty for no auth)
SOCKS5_PASSWORD=

# SOCKS5 connection timeout (e.g., "30s", "1m")
SOCKS5_TIMEOUT=30s

# ============================================
# Advanced Configuration
# ============================================

# TLS allow insecure certificates (true/false)
# WARNING: Only use for testing!
TLS_ALLOW_INSECURE=false

# E2E health check URL (optional)
# Example: http://ipinfo.io/ip
E2E_CHECK_URL=

# ============================================
# Server Selection
# ============================================

# Maximum number of servers to check
MAX_SERVERS=10

# Timeout per server health check (e.g., "5s", "10s")
SERVER_TIMEOUT=5s

# Periodic refresh interval (e.g., "5m", "10m", "1h")
# Leave empty to disable periodic refresh
REFRESH_INTERVAL=10m

# ============================================
# Health Monitoring
# ============================================

# Health check interval (e.g., "10s", "30s")
HEALTH_CHECK_INTERVAL=10s

# Health check timeout (e.g., "5s", "10s")
HEALTH_CHECK_TIMEOUT=5s

# Max retries before failover
HEALTH_MAX_RETRIES=3

# ============================================
# Reconnection Settings
# ============================================

# Max reconnection attempts (0 = unlimited)
RECONNECT_MAX_RETRIES=0

# Initial backoff duration (e.g., "5s", "10s")
RECONNECT_MIN_BACKOFF=5s

# Maximum backoff duration (e.g., "5m", "10m")
RECONNECT_MAX_BACKOFF=5m

# Exponential backoff multiplier (e.g., 2.0)
RECONNECT_BACKOFF_FACTOR=2.0
