# GoXRay VPN Client Configuration File
# This file contains all available configuration options.
# CLI arguments will override values specified here.

# Connection settings
connection:
  # Direct VLESS link (use EITHER this OR from_raw/from_raw_urls, not both)
  # link: "vless://uuid@hostname:443?type=ws&path=/path&security=tls&..."
  
  # Single raw URL for server list (legacy, use from_raw_urls for multiple URLs)
  # from_raw: "https://example.com/links.txt"
  
  # Multiple raw URLs with automatic fallback
  # If first URL fails, tries next ones in order
  from_raw_urls:
    - "https://example.com/links1.txt"
    - "https://backup.example.com/links2.txt"
    - "https://mirror.example.com/links3.txt"
  
  # Enable IPv6 support (default: false)
  enable_ipv6: false
  
  # Allow insecure TLS certificates (default: false)
  tls_allow_insecure: false
  
  # Enable DNS leak protection (default: false)
  # Routes all DNS traffic through VPN to prevent DNS leaks
  enable_dns_protection: false
  
  # Enable kill switch (default: false)
  # Blocks all outbound traffic if VPN disconnects unexpectedly
  # Prevents IP leaks during connection drops using iptables rules
  # IMPORTANT: Requires root/sudo privileges to modify iptables
  enable_kill_switch: false
  
  # Prometheus metrics endpoint port (0 = disabled, default: 0)
  # Exposes metrics at http://0.0.0.0:<port>/metrics
  metrics_port: 0
  
  # E2E health check URL - real traffic verification through VPN tunnel
  # Health checker will perform a real HTTP GET request through SOCKS5 to verify
  # that data actually flows through the tunnel (not just SOCKS proxy being alive).
  # Use an HTTP URL (not HTTPS) to avoid TLS overhead during health checks.
  # Examples: "http://ipinfo.io/ip", "http://connectivitycheck.gstatic.com/generate_204"
  # Leave empty to use SOCKS-only health check (default).
  e2e_check_url: "http://ipinfo.io/ip"

# Server selection and refresh settings
server_selection:
  # Periodically refresh server list (e.g., "5m", "10m", "1h")
  # Set to empty string or remove to disable periodic refresh
  refresh_interval: "10m"
  
  # Maximum number of servers to check (default: 10)
  max_servers: 10
  
  # Timeout per server health check (default: "5s")
  timeout: "5s"

# Reconnection settings (persistence & auto-reconnect)
# Controls behavior when all servers in the list are exhausted.
# The client will re-fetch the server list and retry with exponential backoff.
reconnection:
  # Max reconnection attempts (0 = unlimited retries, default: 0)
  max_retries: 0
  
  # Initial backoff duration (default: "5s")
  # After first failure, waits this long before retrying
  min_backoff: "5s"
  
  # Maximum backoff duration (default: "5m")
  # Backoff grows exponentially up to this limit
  max_backoff: "5m"
  
  # Exponential backoff multiplier (default: 2.0)
  # Each retry waits: min_backoff * backoff_factor^attempt (capped at max_backoff)
  backoff_factor: 2.0

# Logging configuration
logging:
  # Log format: "text" or "json" (default: "text")
  format: "text"
  
  # Log level: "debug", "info", "warn", or "error" (default: "info")
  level: "info"
  
  # Log file path (optional, default: stdout only)
  # file: "/var/log/goxray/goxray.log"
  
  # Max log file size in MB before rotation (default: 100)
  max_size: 100
  
  # Max number of backup log files (default: 3)
  max_backups: 3
  
  # Max age of backup logs in days (default: 28)
  max_age: 28

# Health monitoring settings
health_monitoring:
  # Health check interval (default: "10s")
  check_interval: "10s"
  
  # Health check timeout (default: "5s")
  timeout: "5s"
  
  # Max retries before failover (default: 3)
  max_retries: 3

# Split tunneling settings (selective routing)
# Allows you to route some traffic through VPN and some directly through ISP
split_tunneling:
  # Enable split tunneling (default: false)
  enabled: false
  
  # Mode: "exclude" or "include"
  # - "exclude": All traffic through VPN EXCEPT excluded CIDRs (goes direct)
  # - "include": Only included CIDRs through VPN, rest goes direct
  # - "disabled": All traffic through VPN (same as enabled: false)
  mode: "exclude"
  
  # Excluded CIDRs (used in "exclude" mode)
  # These IP ranges will bypass VPN and go direct through ISP
  exclude_cidrs:
    # Private networks (RFC 1918) - local network access
    - "192.168.0.0/16"    # Local home/office network
    - "10.0.0.0/8"        # Corporate network
    - "172.16.0.0/12"     # Docker networks
    
    # Link-local addresses
    - "169.254.0.0/16"    # APIPA (for mDNS, Bonjour)
    
    # Multicast
    - "224.0.0.0/4"       # Multicast (for DLNA, Chromecast)
    
    # Optional: Specific services for better performance
    # Uncomment if you want these services to bypass VPN
    # - "185.60.216.0/22"   # Netflix CDN
    # - "172.217.0.0/16"    # Google services (YouTube)
    # - "151.101.0.0/16"    # Twitch CDN
  
  # Included CIDRs (used in "include" mode)
  # Only these IP ranges will go through VPN, rest goes direct
  include_cidrs: []
    # Example for include mode (uncomment to use):
    # - "93.184.216.34/32"  # Specific server
    # - "142.250.0.0/15"    # Google IP range
  
  # Future: Domain-based routing (Phase 2 - not yet implemented)
  # exclude_domains: []
  #   - "*.local"
  #   - "*.lan"
  #   - "netflix.com"
  # 
  # include_domains: []
  #   - "*.onion"
  #   - "blocked-site.com"

# SOCKS5 proxy server (optional)
# Allows Windows applications to route traffic through VPN via SOCKS5 proxy
# Useful for applications that don't support TUN/TAP or need explicit proxy configuration
socks5:
  # Enable SOCKS5 proxy server (default: false)
  enabled: false
  
  # Listen address (default: "0.0.0.0:1080")
  # Use "0.0.0.0:1080" to listen on all interfaces
  # Use "127.0.0.1:1080" to listen only on localhost
  listen_addr: "0.0.0.0:1080"
  
  # Authentication (optional, leave empty for no auth)
  # If both username and password are set, SOCKS5 will require authentication
  username: ""
  password: ""
  
  # Connection timeout (default: "30s")
  # Maximum time to wait for connection establishment
  timeout: "30s"
